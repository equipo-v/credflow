{
  "name": "credflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension to track credentials and detect data leakage",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "tldts": "6.1.86"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@eslint/js": "9.39.5",
    "@types/chrome": "0.0.308",
    "eslint": "9.39.5",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "6.4.5",
    "vitest": "3.2.7"
  }
}
