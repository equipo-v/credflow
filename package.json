{
  "name": "credflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension to track credentials and detect data leakage",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "spike:webrequest": "node lab/spike-webrequest/run.mjs",
    "audit": "npm audit --audit-level=moderate",
    "verify": "npm run audit && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "tldts": "6.1.86"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.0.308",
    "eslint": "10.14.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "6.4.5",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
